{
  "name": "vidar",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node tools/ui/lint-ui.mjs && node tools/ui/lint-copy.mjs && tsc --noEmit && vite build && node -e \"const f='tools/release/icon-gate.mjs';if(fs.existsSync(f)){const r=require('child_process').spawnSync('node',[f],{stdio:'inherit'});process.exit(r.status??1)}\"",
    "build:falcon": "npm run build && node tools/falcon/build.mjs",
    "tauri": "tauri",
    "lint:ui": "node tools/ui/lint-copy.mjs && node tools/ui/lint-ui.mjs",
    "lint:copy": "node tools/ui/lint-copy.mjs",
    "test": "node --test --test-timeout=120000 \"tests/**/*.test.mjs\" \"tools/**/*.test.mjs\"",
    "prepare": "node -e \"fs.existsSync('tools/gate/hooks-path.mjs')&&import('./tools/gate/hooks-path.mjs')\"",
    "gate": "node tools/gate/gate.mjs full",
    "gate:fast": "node tools/gate/gate.mjs fast"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.266",
    "@tauri-apps/api": "^2.11.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "^6.0.0",
    "markdown-it": "^14.3.1",
    "three": "0.171.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/markdown-it": "^14.2.0",
    "@types/three": "0.171.0",
    "jsdom": "30.1.1",
    "knip": "6.40.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
