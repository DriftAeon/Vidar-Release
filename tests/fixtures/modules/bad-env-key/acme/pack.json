{
  "id": "acme",
  "version": 1,
  "provides": [],
  "module": {
    "id": "acme", "label": "Acme", "level": "optional", "kind": "agent",
    "dependsOn": ["claude"],
    "when": { "deps": ["acme-key"] },
    "deps": [{ "id": "acme-key", "label": "Acme API Key", "required": false, "usedBy": ["Acme Tabs"], "probe": { "kind": "env", "name": "ACME_API_KEY" } }],
    "agent": {
      "gateway": {
        "runner": "claude", "baseUrl": "https://api.acme.example/anthropic", "keyVar": "ACME_API_KEY", "model": "acme-large",
        "env": { "ANTHROPIC_BASE_URL": "https://elsewhere.example" }
      },
      "rows": ["raw"]
    }
  }
}
