{
  "$comment": "Every channel Vidar writes into an agent session, and the rune kind (or plumbing) that carries it. Plan-rev2 E6, state after R.6. Test: tests/session-channels.test.mjs.",
  "channels": [
    { "id": "claude-append-system-prompt", "agents": ["claude"], "carrier": "rule", "writer": ["src/rules/inject.ts", "src-tauri/src/bare/claude_line.rs", "tools/claude-sidecar.mjs"] },
    { "id": "claude-settings", "agents": ["claude"], "carrier": "setting", "writer": ["src-tauri/src/bare/home.rs"] },
    { "id": "claude-settings-permissions", "agents": ["claude"], "carrier": "permission", "writer": ["src-tauri/src/bare/home.rs", "src-tauri/src/bare/rune_items.rs"] },
    { "id": "claude-settings-hooks", "agents": ["claude"], "carrier": "hook", "writer": ["src-tauri/src/bare/home.rs", "src-tauri/src/bare/guards.rs"] },
    { "id": "claude-built-in-skills", "agents": ["claude"], "carrier": "skill", "key": "built-in", "writer": ["src-tauri/src/bare/builtin_off.rs"] },
    { "id": "claude-built-in-plugins", "agents": ["claude"], "carrier": "plugin", "key": "built-in", "writer": ["src-tauri/src/bare/builtin_off.rs"] },
    { "id": "claude-skill-listing", "agents": ["claude"], "carrier": "skill", "writer": ["src-tauri/src/bare/copies.rs", "src-tauri/src/bare/claude_launch.rs"] },
    { "id": "claude-strict-mcp", "agents": ["claude"], "carrier": "mcp", "writer": ["src-tauri/src/bare/claude_mcp.rs", "src-tauri/src/bare/claude_line.rs"] },
    { "id": "gate-sid8-line", "agents": ["claude"], "carrier": "plugin", "writer": ["plugins/gate/hooks/register.js"] },
    { "id": "claude-env", "agents": ["claude"], "carrier": "plumbing", "reason": "The overlay and allowlist are isolation: a rune cannot say drop everything else.", "writer": ["src-tauri/src/bare/env.rs"] },
    { "id": "claude-env-runes", "agents": ["claude"], "carrier": "plugin", "key": "env", "writer": ["src-tauri/src/bare/env.rs", "src-tauri/src/bare/claude_launch.rs", "src-tauri/src/bare/flow_vault.rs", "src-tauri/src/falcon/session_commands.rs", "src-falcon/src/claude.rs"] },
    { "id": "codex-env-runes", "agents": ["codex"], "carrier": "plugin", "key": "env", "writer": ["src-tauri/src/bare/env.rs", "src-tauri/src/bare/codex_hosted.rs"] },
    { "id": "claude-instruction-files", "agents": ["claude"], "carrier": "setting", "writer": ["src-tauri/src/bare/home.rs", "src-tauri/src/bare/claude_profile.rs"] },
    { "id": "claude-remote-control", "agents": ["claude"], "carrier": "plumbing", "reason": "A user setting, not a rune.", "writer": ["src-tauri/src/bare/claude_line.rs"] },
    { "id": "codex-developer-instructions", "agents": ["codex"], "carrier": "rule", "writer": ["src-tauri/src/bare/home.rs", "src/rules/inject.ts"] },
    { "id": "codex-config", "agents": ["codex"], "carrier": "setting", "writer": ["src-tauri/src/bare/home.rs"] },
    { "id": "codex-config-mcp", "agents": ["codex"], "carrier": "mcp", "writer": ["src-tauri/src/bare/codex_mcp.rs"] },
    { "id": "codex-config-hooks", "agents": ["codex"], "carrier": "hook", "writer": ["src-tauri/src/bare/codex_hooks.rs"] },
    { "id": "codex-config-agents", "agents": ["codex"], "carrier": "agent", "writer": ["src-tauri/src/bare/codex_roles.rs"] },
    { "id": "codex-built-in-skills", "agents": ["codex"], "carrier": "skill", "key": "built-in", "writer": ["src-tauri/src/bare/builtin_off.rs", "src-tauri/src/bare/codex_hosted.rs"] },
    { "id": "codex-repo-skills", "agents": ["codex"], "carrier": "skill", "writer": ["src-tauri/src/bare/builtin_off.rs", "src-tauri/src/bare/codex_hosted.rs"] },
    { "id": "codex-cwd-config", "agents": ["codex"], "carrier": "plumbing", "reason": "The trust table stays because the TUI prompts without it (probe 11-02); a launch folder's .codex config loads only once the user trusts it.", "writer": ["src-tauri/src/bare/home.rs", "src-tauri/src/bare/codex_user_trust.rs"] },
    { "id": "ctl-token-skill", "agents": ["claude", "codex"], "carrier": "skill", "key": "ctl", "writer": ["src-tauri/src/pty.rs", "src-tauri/src/falcon/session_commands.rs", "src-tauri/src/bare/flow_vault.rs", "src-tauri/src/agent/codex.rs"] },
    { "id": "ctl-token-mcp", "agents": ["claude", "codex"], "carrier": "mcp", "key": "ctl", "writer": ["src-tauri/src/pty.rs", "src-tauri/src/falcon/session_commands.rs", "src-tauri/src/bare/flow_vault.rs", "src-tauri/src/agent/codex.rs"] },
    { "id": "notify", "agents": ["codex"], "carrier": "plumbing", "reason": "Completion signal to Vidar; nothing reaches the model.", "writer": ["src-tauri/src/bare/home.rs"] },
    { "id": "git-identity", "agents": ["claude", "codex"], "carrier": "plumbing", "reason": "The user's git identity copied into the Bare home; no model feedback.", "writer": ["src-tauri/src/bare/identity.rs"] },
    { "id": "login-link", "agents": ["claude", "codex"], "carrier": "plumbing", "reason": "Shared login synced into the Bare home; no model feedback.", "writer": ["src-tauri/src/bare/login_link.rs", "src-tauri/src/bare/login_link_claude.rs", "src-tauri/src/bare/login_link_codex.rs"] },
    { "id": "claude-json-seed", "agents": ["claude"], "carrier": "plumbing", "reason": "Seen-counters mirrored so one-time notices stay quiet; no model feedback.", "writer": ["src-tauri/src/bare/home.rs"] },
    { "id": "claude-plain-tab", "agents": ["claude"], "carrier": "plumbing", "reason": "Not a Bare session, so nothing is injected (0da90100).", "writer": ["src-tauri/src/pty.rs"] }
  ]
}
