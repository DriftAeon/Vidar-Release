      "home": ["src/format.ts"],
      "use": "label or titleWords from src/format.ts",
      "scan": { "roots": ["src"], "ext": [".ts"] },
      "shapes": [
        { "re": "\\.charAt\\(0\\)\\.toUpperCase\\(\\)" },
        { "re": "\\[0\\]\\.toUpperCase\\(\\)" },
        { "re": "\\.toUpperCase\\(\\)[^\\n]*\\.slice\\(1\\)" }
      ],
      "mark": "case-ok:",
      "frozen": {},
      "origin": "2026-10-28 c622cc9f 72895bc0"
    },
    {
      "id": "vault-ipc",
      "home": ["src/runes/bare/vault-io.ts"],
      "use": "vaultIpc or tabVaultIo from src/runes/bare/vault-io.ts",
      "scan": { "roots": ["src"], "ext": [".ts"] },
      "shapes": [
        { "lit": "invoke(\"rune_vault_list\"" },
        { "lit": "invoke(\"rune_vault_read\"" },
        { "lit": "invoke(\"rune_vault_lock\"" },
        { "lit": "invoke(\"rune_vault_edit\"" }
      ],
      "frozen": {},
      "origin": "2026-10-31 runes duplication sweep item 2"
    },
    {
