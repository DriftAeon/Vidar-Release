{
  "autoMemoryEnabled": false,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "disableClaudeAiConnectors": true,
  "pluginConfigs": {
    "cc-plugin-agents-md@builtin": {
      "options": {
        "instructionFiles": "managed-only"
      }
    }
  },
  "claudeMdExcludes": [
    "**/CLAUDE.md",
    "**/CLAUDE.local.md",
    "**/AGENTS.md",
    "**/.claude/rules/**"
  ],
  "permissions": {
    "allow": [
      "mcp__plugin_vidar_drive"
    ],
    "ask": [
      "mcp__atlassian__executeWrite",
      "mcp__atlassian__executeDestructive",
      "mcp__atlassian__createJiraIssue",
      "mcp__atlassian__editJiraIssue",
      "mcp__atlassian__transitionJiraIssue",
      "mcp__atlassian__addOrEditJiraIssueComment",
      "mcp__atlassian__createConfluenceContent",
      "mcp__atlassian__updateConfluenceContent",
      "mcp__atlassian__addGraphContext",
      "mcp__notion__notion-create-pages",
      "mcp__notion__notion-update-page",
      "mcp__notion__notion-move-pages",
      "mcp__notion__notion-duplicate-page",
      "mcp__notion__notion-delete-pages",
      "mcp__notion__notion-restore-pages",
      "mcp__notion__notion-create-database",
      "mcp__notion__notion-update-data-source",
      "mcp__notion__notion-delete-databases",
      "mcp__notion__notion-create-view",
      "mcp__notion__notion-update-view",
      "mcp__notion__notion-create-folder",
      "mcp__notion__notion-update-folder",
      "mcp__notion__notion-create-comment",
      "mcp__notion__notion-update-comment",
      "mcp__notion__notion-delete-comment",
      "mcp__notion__notion-set-comment-reaction",
      "mcp__notion__notion-set-discussion-resolved",
      "mcp__notion__notion-create-attachment",
      "mcp__notion__notion-create-file-upload",
      "mcp__notion__notion-calendar-create-events",
      "mcp__notion__notion-calendar-update-events",
      "mcp__notion__notion-calendar-cancel-events",
      "mcp__notion__notion-convert-page-to-skill",
      "mcp__notion__notion-upload-skill",
      "mcp__notion__notion-update-enabled-skills",
      "mcp__notion__notion-spawn-session",
      "mcp__notion__notion-send-message-to-session",
      "mcp__notion__notion-stop-session",
      "mcp__slack__slack_send_message",
      "mcp__slack__slack_send_message_draft",
      "mcp__slack__slack_schedule_message",
      "mcp__slack__slack_add_reaction",
      "mcp__slack__slack_create_conversation",
      "mcp__slack__slack_create_canvas",
      "mcp__slack__slack_update_canvas",
      "mcp__slack__slack_create_list",
      "mcp__slack__slack_update_list",
      "mcp__slack__slack_add_list_record",
      "mcp__slack__slack_update_list_record",
      "mcp__slack__slack_get_file_upload_url",
      "mcp__slack__slack_complete_file_upload"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"{{root}}\\tools\\agent-layer\\statusline-bridge.mjs\" --root \"{{root}}\" --home \"{{home}}\""
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{root}}\\tools\\agent-layer\\guard-driver.mjs\" --root \"{{root}}\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{root}}\\tools\\agent-layer\\context-gate.mjs\" prompt --root \"{{root}}\" --home \"{{home}}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{root}}\\tools\\agent-layer\\context-gate.mjs\" stop --root \"{{root}}\" --home \"{{home}}\""
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{root}}\\tools\\agent-layer\\instructions-log.mjs\" --root \"{{root}}\" --home \"{{home}}\""
          }
        ]
      }
    ]
  }
}
